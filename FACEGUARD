python3.13/dist-packages/face_recognition_models/__init__.py:7: UserWarning: pkg_resources is deprecated as an API. See https://setuptools.pypa.io/en/latest/pkg_resources.html. The pkg_resources package is slated for removal as early as 2025-11-30. Refrain from using this package or pin to Setuptools<81.\n","  from pkg_resources import resource_filename\n"]},{"output_type":"stream","name":"stdout","text":["FaceGuard ready.\n"]}]},{"cell_type":"code","source":["def create_database():\n","    conn = sqlite3.connect(DB_PATH)\n","    conn.execute('''CREATE TABLE IF NOT EXISTS users (\n","        id INTEGER PRIMARY KEY AUTOINCREMENT,\n","        name TEXT NOT NULL,\n","        user_id TEXT UNIQUE NOT NULL,\n","        department TEXT,\n","        email TEXT,\n","        face_encoding TEXT NOT NULL\n","    )''')\n","    conn.execute('''CREATE TABLE IF NOT EXISTS access_logs (\n","        id INTEGER PRIMARY KEY AUTOINCREMENT,\n","        name TEXT,\n","        user_id TEXT,\n","        status TEXT NOT NULL,\n","        timestamp TEXT NOT NULL\n","    )''')\n","    conn.commit()\n","    conn.close()\n","\n","create_database()\n"],"metadata":{"id":"ioMviwtqWNEV","executionInfo":{"status":"ok","timestamp":1791191824738,"user_tz":-330,"elapsed":46,"user":{"displayName":"Vivena Benitus J","userId":"05640412731785739665"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["def add_user(name, user_id, department, email, encoding):\n","    conn = sqlite3.connect(DB_PATH)\n","    try:\n","        conn.execute(\n","            \"INSERT INTO users (name,user_id,department,email,face_encoding) VALUES (?,?,?,?,?)\",\n","            (name, user_id, department, email, json.dumps(encoding))\n","        )\n","        conn.commit()\n","        return True, f\"✅ {name} ({user_id}) registered successfully.\"\n","    except sqlite3.IntegrityError:\n","        return False, f\"❌ User ID '{user_id}' already exists.\"\n","    finally:\n","        conn.close()\n","\n","def users_df():\n","    conn = sqlite3.connect(DB_PATH)\n","    df = pd.read_sql_query(\n","        \"SELECT id,name,user_id,department,email FROM users ORDER BY id DESC\", conn)\n","    conn.close()\n","    return df\n","\n","def face_users():\n","    conn = sqlite3.connect(DB_PATH)\n","    rows = conn.execute(\n","        \"SELECT name,user_id,department,email,face_encoding FROM users\").fetchall()\n","    conn.close()\n","    return [\n","        {\"name\":r[0],\"user_id\":r[1],\"department\":r[2],\n","         \"email\":r[3],\"face_encoding\":r[4]} for r in rows\n","    ]\n","\n","def add_log(name, user_id, status):\n","    conn = sqlite3.connect(DB_PATH)\n","    conn.execute(\n","        \"INSERT INTO access_logs(name,user_id,status,timestamp) VALUES(?,?,?,?)\",\n","        (name,user_id,status,datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")))\n","    conn.commit()\n","    conn.close()\n","\n","def logs_df():\n","    conn = sqlite3.connect(DB_PATH)\n","    df = pd.read_sql_query(\n","        \"SELECT name,user_id,status,timestamp FROM access_logs ORDER BY id DESC\", conn)\n","    conn.close()\n","    return df\n"],"metadata":{"id":"hYLO2lLpWl44","executionInfo":{"status":"ok","timestamp":1791191838413,"user_tz":-330,"elapsed":15,"user":{"displayName":"Vivena Benitus J","userId":"05640412731785739665"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["def get_encoding(image):\n","    if image is None:\n","        return None, \"❌ Please provide a face image.\"\n","\n","    rgb = image if isinstance(image, np.ndarray) else np.array(image.convert(\"RGB\"))\n","    locations = face_recognition.face_locations(rgb)\n","\n","    if len(locations) == 0:\n","        return None, \"❌ No face detected.\"\n","    if len(locations) > 1:\n","        return None, \"❌ Multiple faces detected. Use only one person.\"\n","\n","    enc = face_recognition.face_encodings(rgb, locations)[0]\n","    return enc.tolist(), None\n","\n","def register_user(name, user_id, department, email, image):\n","    name, user_id = (name or \"\").strip(), (user_id or \"\").strip()\n","    department, email = (department or \"\").strip(), (email or \"\").strip()\n","\n","    if not name or not user_id:\n","        return \"❌ Name and User ID are required.\", users_df()\n","\n","    encoding, error = get_encoding(image)\n","    if error:\n","        return error, users_df()\n","\n","    _, message = add_user(name, user_id, department, email, encoding)\n","    return message, users_df()\n"],"metadata":{"id":"fy4F95MAWpIa","executionInfo":{"status":"ok","timestamp":1791191851189,"user_tz":-330,"elapsed":6,"user":{"displayName":"Vivena Benitus J","userId":"05640412731785739665"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["def recognize_face(image):\n","    if image is None:\n","        return \"⚪ Waiting for a face...\", \"No image received.\", None, logs_df()\n","\n","    rgb = image if isinstance(image, np.ndarray) else np.array(image.convert(\"RGB\"))\n","    locations = face_recognition.face_locations(rgb)\n","    encodings = face_recognition.face_encodings(rgb, locations)\n","\n","    if not encodings:\n","        add_log(\"Unknown Person\", \"-\", \"DENIED\")\n","        return \"🔴 ACCESS DENIED\", \"No face detected.\", rgb, logs_df()\n","\n","    users = face_users()\n","    if not users:\n","        add_log(\"Unknown Person\", \"-\", \"DENIED\")\n","        return \"🔴 ACCESS DENIED\", \"No users are registered.\", rgb, logs_df()\n","\n","    face_encoding = encodings[0]\n","    best, best_distance = None, float(\"inf\")\n","\n","    for user in users:\n","        stored = np.array(json.loads(user[\"face_encoding\"]))\n","        distance = float(face_recognition.face_distance([stored], face_encoding)[0])\n","        if distance < best_distance:\n","            best_distance, best = distance, user\n","\n","    pil = Image.fromarray(rgb.copy())\n","    draw = ImageDraw.Draw(pil)\n","    top, right, bottom, left = locations[0]\n","\n","    if best is not None and best_distance <= FACE_TOLERANCE:\n","        status = \"🟢 ACCESS GRANTED\"\n","        details = (\n","            f\"Name: {best['name']}\\n\"\n","            f\"User ID: {best['user_id']}\\n\"\n","            f\"Department: {best['department'] or '-'}\\n\"\n","            f\"Email: {best['email'] or '-'}\\n\"\n","            f\"Match Distance: {best_distance:.4f}\"\n","        )\n","        add_log(best[\"name\"], best[\"user_id\"], \"GRANTED\")\n","        box, label = \"green\", f\"{best['name']} - GRANTED\"\n","    else:\n","        status = \"🔴 ACCESS DENIED\"\n","        details = f\"Name: Unknown Person\\nUser ID: -\\nMatch Distance: {best_distance:.4f}\"\n","        add_log(\"Unknown Person\", \"-\", \"DENIED\")\n","        box, label = \"red\", \"Unknown Person - DENIED\"\n","\n","    draw.rectangle([(left,top),(right,bottom)], outline=box, width=5)\n","    draw.text((left, max(0,top-25)), label, fill=box)\n","\n","    return status, details, np.array(pil), logs_df()\n"],"metadata":{"id":"6vYVLT4UWzVv","executionInfo":{"status":"ok","timestamp":1791191892275,"user_tz":-330,"elapsed":39,"user":{"displayName":"Vivena Benitus J","userId":"05640412731785739665"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["with gr.Blocks(title=\"FaceGuard\", theme=gr.themes.Soft()) as demo:\n","    gr.Markdown(\"# 🛡️ FaceGuard\\n### Smart Face Recognition Access Control System\")\n","\n","    with gr.Tab(\"👤 Register User\"):\n","        gr.Markdown(\"Register as many users/IDs as you need.\")\n","        with gr.Row():\n","            with gr.Column():\n","                name = gr.Textbox(label=\"Name\")\n","                uid = gr.Textbox(label=\"User ID / Register Number\", placeholder=\"CSE001\")\n","                dept = gr.Textbox(label=\"Department\")\n","                email = gr.Textbox(label=\"Email\")\n","            with gr.Column():\n","                reg_image = gr.Image(sources=[\"webcam\",\"upload\"], type=\"numpy\",\n","                                     label=\"Capture / Upload Face\")\n","\n","        reg_btn = gr.Button(\"📸 Register User\", variant=\"primary\")\n","        reg_msg = gr.Textbox(label=\"Registration Status\", interactive=False)\n","        reg_table = gr.Dataframe(value=users_df(), label=\"Registered Users\", interactive=False)\n","\n","        reg_btn.click(\n","            register_user,\n","            [name,uid,dept,email,reg_image],\n","            [reg_msg,reg_table]\n","        )\n","\n","    with gr.Tab(\"📷 Face Recognition\"):\n","        gr.Markdown(\"Show a registered or unknown face to the webcam.\")\n","        camera = gr.Image(sources=[\"webcam\",\"upload\"], type=\"numpy\",\n","                          label=\"FaceGuard Camera\")\n","        check = gr.Button(\"🔍 Check Access\", variant=\"primary\")\n","        status = gr.Textbox(label=\"Access Status\", interactive=False)\n","        details = gr.Textbox(label=\"User Details\", lines=6, interactive=False)\n","        result = gr.Image(label=\"Recognition Result\")\n","        recent = gr.Dataframe(value=logs_df(), label=\"Recent Access Logs\", interactive=False)\n","\n","        check.click(recognize_face, camera, [status,details,result,recent])\n","\n","    with gr.Tab(\"👥 Registered Users\"):\n","        refresh_users = gr.Button(\"🔄 Refresh\")\n","        all_users = gr.Dataframe(value=users_df(), interactive=False)\n","        refresh_users.click(users_df, outputs=all_users)\n","\n","    with gr.Tab(\"📋 Access Logs\"):\n","        refresh_logs = gr.Button(\"🔄 Refresh\")\n","        all_logs = gr.Dataframe(value=logs_df(), interactive=False)\n","        refresh_logs.click(logs_df, outputs=all_logs)\n","\n","    gr.Markdown(\"---\\n**FaceGuard prototype — protect stored biometric data and use with consent.**\")\n","\n","demo.launch(share=True)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":648},"id":"BhVPihRqW25O","executionInfo":{"status":"ok","times